# Substrate ActorTemplate resource (protojson-shaped ateapipb.ActorTemplate,
# NOT the ate.dev/v1alpha1 CRD): one of the three agents of the
# claude-code-multiplex demo, all sharing one 2-pod WorkerPool (see
# claude-code-multiplex.yaml.tmpl). Applied with
# `kubectl ate create actor-template -f -`; the claude-multiplex-demo
# atespace must exist. WORKLOAD_IMAGE is the digest-pinned workload image the
# install script builds and pushes; ANTHROPIC_API_KEY is substituted as a
# plain value at apply time.

metadata:
  atespace: claude-multiplex-demo
  name: agent-orion
workerSelector:
  matchLabels:
    workload: claude-multiplex
containers:
- name: claude
  image: ${WORKLOAD_IMAGE}
  env:
  - name: ACTOR_NAME
    value: "orion"
  - name: TASK
    value: "Suggest one healthy meal that takes under 15 minutes to prepare. One sentence."
  - name: INTERVAL_SECONDS
    value: "45"
  - name: ANTHROPIC_API_KEY
    value: "${ANTHROPIC_API_KEY}"
snapshotsConfig:
  storageLocation: gs://${BUCKET_NAME}/claude-multiplex-demo/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default
