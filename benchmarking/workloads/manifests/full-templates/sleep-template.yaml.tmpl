# Substrate ActorTemplate resource (protojson-shaped ateapipb.ActorTemplate,
# NOT the ate.dev/v1alpha1 CRD): the sleep workload of the full benchmark set
# (see full_workloads.yaml.tmpl, which is not wired into deploy.sh yet).

metadata:
  atespace: benchmark-workloads
  name: sleep
workerSelector:
  matchLabels:
    workload: benchmark-ateom
containers:
- name: sleep
  image: busybox@sha256:1487d0af5f52b4ba31c7e465126ee2123fe3f2305d638e7827681e7cf6c83d5e
  command: ["/bin/sleep", "1000000"]
snapshotsConfig:
  storageLocation: gs://${BUCKET_NAME}/benchmark-workloads/sleep/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default
