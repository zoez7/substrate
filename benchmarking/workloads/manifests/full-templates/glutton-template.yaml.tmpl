# Substrate ActorTemplate resource (protojson-shaped ateapipb.ActorTemplate,
# NOT the ate.dev/v1alpha1 CRD): the glutton workload of the full benchmark set
# (see full_workloads.yaml.tmpl, which is not wired into deploy.sh yet).

metadata:
  atespace: benchmark-workloads
  name: glutton
workerSelector:
  matchLabels:
    workload: benchmark-ateom
containers:
- name: glutton
  image: ko://github.com/agent-substrate/substrate/cmd/benchmarking/glutton
  # Port 80 is the only inbound port nftables forwards from the worker pod
  # into the actor sandbox (see cmd/ateom-gvisor/main.go).
  command:
  - "/ko-app/glutton"
  - "--grpc-listen-addr=:80"
  - "--metrics-listen-addr=:9090"
  - "--data-dir=/tmp/glutton"
snapshotsConfig:
  storageLocation: gs://${BUCKET_NAME}/benchmark-workloads/glutton/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default
